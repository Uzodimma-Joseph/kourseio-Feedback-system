# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random long string used as part of the webhook URL path, so only
# Telegram (who we tell) knows the real endpoint. Generate with e.g.
# `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL of THIS deployed bot (e.g. your Railway domain).
# Used on boot to register the Telegram webhook automatically.
PUBLIC_URL=

# The n8n Webhook node URL that receives customer messages from this bot.
N8N_WEBHOOK_URL=

# Shared secret n8n must send (as X-Bot-Callback-Secret) when it calls
# this bot's /api/telegram/send endpoint to deliver a reply or admin alert.
BOT_CALLBACK_SECRET=

# How long (ms) to wait for n8n to accept a forwarded message before
# falling back to a graceful in-bot error reply. This is NOT how long
# n8n has to finish the AI reply — that arrives later via the callback.
N8N_TIMEOUT_MS=10000

PORT=3000
